# 猫猫图鉴家 - 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# 🐱 猫品种识别 API（推荐百度，免费额度多）
# 百度智能云 - 动物识别
# 注册地址：https://console.bce.baidu.com/
# 1. 注册百度账号
# 2. 开通"图像识别"服务
# 3. 创建应用，获取 API Key 和 Secret Key
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# Nyckel - 猫品种识别（备选）
# 注册地址：https://www.nyckel.com/
NYCKEL_API_KEY=your_nyckel_api_key_here
NYCKEL_FUNCTION_ID=cat_breed_classifier

# 🎬 视频总结 API（推荐通义千问，有90天免费额度）
# 通义千问（推荐）- 阿里云百炼
# 注册地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# BibiGPT（备选）
# 注册地址：https://bibigpt.co/
BIBIGPT_API_KEY=your_bibigpt_api_key_here

# 🔧 服务配置
PORT=3001
